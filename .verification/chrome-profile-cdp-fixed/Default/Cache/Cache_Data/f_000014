ative;\r\n  padding: 2rem;\r\n  border: 1.5px solid rgba(0, 209, 255, 0.25);\r\n  border-radius: 14px;\r\n  background: rgba(6, 20, 48, 0.75);\r\n  backdrop-filter: blur(16px);\r\n  transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);\r\n  cursor: pointer;\r\n  overflow: hidden;\r\n  box-shadow: \r\n    0 8px 32px rgba(0, 0, 0, 0.2),\r\n    inset 0 1px 0 rgba(255, 255, 255, 0.05);\r\n}\r\n\r\n.uc-use-case-card:hover {\r\n  border-color: rgba(0, 209, 255, 0.55);\r\n  background: rgba(6, 20, 48, 0.95);\r\n  transform: translateY(-8px);\r\n  box-shadow: \r\n    0 20px 60px rgba(0, 209, 255, 0.18),\r\n    0 0 40px rgba(0, 209, 255, 0.12),\r\n    inset 0 1px 0 rgba(255, 255, 255, 0.08);\r\n}\r\n\r\n.uc-card-header-wrapper {\r\n  display: flex;\r\n  align-items: flex-start;\r\n  gap: 1rem;\r\n  margin-bottom: 1.25rem;\r\n}\r\n\r\n.uc-card-icon-large {\r\n  font-size: 2.5rem;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  min-width: 60px;\r\n  height: 60px;\r\n  background: rgba(0, 209, 255, 0.12);\r\n  border: 1px solid rgba(0, 209, 255, 0.3);\r\n  border-radius: 12px;\r\n  animation: iconBounce 3s ease-in-out infinite;\r\n  transition: all 0.3s ease;\r\n}\r\n\r\n.uc-use-case-card:hover .uc-card-icon-large {\r\n  background: rgba(0, 209, 255, 0.2);\r\n  transform: scale(1.1) translateY(-4px);\r\n}\r\n\r\n.uc-card-title-large {\r\n  margin: 0;\r\n  font-size: 1.2rem;\r\n  font-weight: 700;\r\n  color: #f5fbff;\r\n  line-height: 1.3;\r\n}\r\n\r\n.uc-card-desc-large {\r\n  margin: 0;\r\n  font-size: 0.95rem;\r\n  color: #c0cdd8;\r\n  font-weight: 300;\r\n  line-height: 1.6;\r\n}\r\n\r\n.uc-card-border-glow {\r\n  position: absolute;\r\n  inset: 0;\r\n  border-radius: 14px;\r\n  background: linear-gradient(135deg, rgba(0, 209, 255, 0.1) 0%, transparent 100%);\r\n  opacity: 0;\r\n  transition: opacity 0.3s ease;\r\n  pointer-events: none;\r\n}\r\n\r\n.uc-card-border-glow.active {\r\n  opacity: 1;\r\n}\r\n\r\n/* CENTER - 3D RACK ANIMATION */\r\n.uc-center-rack-animation {\r\n  position: relative;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  height: 100%;\r\n  min-height: 500px;\r\n  animation: fadeInScale 1s ease-out 0.4s both;\r\n}\r\n\r\n.uc-rack-animation-wrapper {\r\n  position: relative;\r\n  width: 100%;\r\n  height: 100%;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  perspective: 1500px;\r\n}\r\n\r\n.uc-dc-rack-svg {\r\n  width: 100%;\r\n  height: 100%;\r\n  max-width: 100%;\r\n  max-height: 500px;\r\n  filter: drop-shadow(0 0 50px rgba(0, 209, 255, 0.25)) drop-shadow(0 20px 60px rgba(0, 0, 0, 0.5));\r\n  animation: rackRotate 20s linear infinite;\r\n}\r\n\r\n/* Rack animations */\r\n.uc-outer-glow {\r\n  animation: pulseGlow 3s ease-in-out infinite;\r\n}\r\n\r\n.uc-main-rack {\r\n  animation: rackBobbing 4s ease-in-out infinite;\r\n}\r\n\r\n.uc-rack-device {\r\n  animation: deviceGlow 2s ease-in-out infinite;\r\n}\r\n\r\n.uc-device-status {\r\n  animation: statusPulse 1.5s ease-in-out infinite;\r\n}\r\n\r\n.uc-system-status-text {\r\n  animation: textGlow 2s ease-in-out infinite;\r\n}\r\n\r\n.uc-orbit-circle {\r\n  position: absolute;\r\n  border: 1px solid rgba(0, 209, 255, 0.2);\r\n  border-radius: 50%;\r\n  pointer-events: none;\r\n}\r\n\r\n.uc-orbit-1 {\r\n  width: 500px;\r\n  height: 500px;\r\n  top: 50%;\r\n  left: 50%;\r\n  transform: translate(-50%, -50%);\r\n  animation: orbitRotateOuter 30s linear infinite;\r\n}\r\n\r\n.uc-orbit-2 {\r\n  width: 350px;\r\n  height: 350px;\r\n  top: 50%;\r\n  left: 50%;\r\n  transform: translate(-50%, -50%);\r\n  animation: orbitRotateInner 20s linear infinite reverse;\r\n}\r\n\r\n/* STATS SECTION */\r\n.uc-use-cases-stats-section {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));\r\n  gap: 2rem;\r\n  max-width: 1200px;\r\n  margin: 3rem auto;\r\n  position: relative;\r\n  z-index: 2;\r\n  animation: fadeInUp 0.8s ease 0.6s both;\r\n}\r\n\r\n.uc-stat-item {\r\n  text-align: center;\r\n  padding: 2rem 1.5rem;\r\n  border: 1px solid rgba(0, 209, 255, 0.15);\r\n  border-radius: 12px;\r\n  background: rgba(6, 20, 48, 0.6);\r\n  backdrop-filter: blur(10px);\r\n  transition: all 0.3s ease;\r\n}\r\n\r\n.uc-stat-item:hover {\r\n  border-color: rgba(0, 209, 255, 0.4);\r\n  background: rgba(6, 20, 48, 0.85);\r\n  transform: translateY(-6px);\r\n  box-shadow: 0 12px 40px rgba(0, 209, 255, 0.15);\r\n}\r\n\r\n.uc-stat-icon {\r\n  font-size: 2.5rem;\r\n  margin-bottom: 1rem;\r\n  display: inline-block;\r\n}\r\n\r\n.uc-stat-value {\r\n  font-size: clamp(1.8rem, 2.5vw, 2.5rem);\r\n  font-weight: 800;\r\n  background: linear-gradient(135deg, #00d1ff, #7ceeff);\r\n  -webkit-background-clip: text;\r\n  background-clip: text;\r\n  color: transparent;\r\n  -webkit-text-fill-color: transparent;\r\n  margin-bottom: 0.5rem;\r\n  line-height: 1.1;\r\n}\r\n\r\n.uc-stat-label {\r\n  font-size: 0.95rem;\r\n  color: #b9c8d2;\r\n  font-weight: 400;\r\n  line-height: 1.5;\r\n}\r\n\r\n/* CTA BUTTONS */\r\n.uc-use-cases-cta-buttons {\r\n  display: flex;\r\n  gap: 1.5rem;\r\n  justify-content: center;\r\n  flex-wrap: wrap;\r\n  position: relative;\r\n  z-index: 2;\r\n  animation: fadeInUp 0.8s ease 0.7s both;\r\n}\r\n\r\n/* ANIMATIONS */\r\n@keyframes rackRotate {\r\n  from {\r\n    transform: rotateX(5deg) rotateY(0deg) rotateZ(0deg);\r\n  }\r\n  to {\r\n    transform: rotateX(5deg) rotateY(360deg) rotateZ(0deg);\r\n  }\r\n}\r\n\r\n@keyframes rackBobbing {\r\n  0%, 100% {\r\n    transform: translateY(0px);\r\n  }\r\n  50% {\r\n    transform: translateY(-12px);\r\n  }\r\n}\r\n\r\n@keyframes deviceGlow {\r\n  0%, 100% {\r\n    opacity: 0.6;\r\n    filter: drop-shadow(0 0 4px rgba(0, 209, 255, 0.3));\r\n  }\r\n  50% {\r\n    opacity: 1;\r\n    filter: drop-shadow(0 0 10px rgba(0, 209, 255, 0.7));\r\n  }\r\n}\r\n\r\n@keyframes statusPulse {\r\n  0%, 100% {\r\n    opacity: 0.5;\r\n    r: 2px;\r\n  }\r\n  50% {\r\n    opacity: 1;\r\n    r: 3px;\r\n  }\r\n}\r\n\r\n@keyframes textGlow {\r\n  0%, 100% {\r\n    opacity: 0.6;\r\n    filter: drop-shadow(0 0 3px rgba(124, 238, 255, 0.3));\r\n  }\r\n  50% {\r\n    opacity: 1;\r\n    filter: drop-shadow(0 0 8px rgba(124, 238, 255, 0.8));\r\n  }\r\n}\r\n\r\n@keyframes pulseGlow {\r\n  0%, 100% {\r\n    opacity: 0.3;\r\n    stroke-width: 1;\r\n  }\r\n  50% {\r\n    opacity: 0.6;\r\n    stroke-width: 1.5;\r\n  }\r\n}\r\n\r\n@keyframes orbitRotateOuter {\r\n  from {\r\n    transform: translate(-50%, -50%) rotateZ(0deg);\r\n  }\r\n  to {\r\n    transform: translate(-50%, -50%) rotateZ(360deg);\r\n  }\r\n}\r\n\r\n@keyframes orbitRotateInner {\r\n  from {\r\n    transform: translate(-50%, -50%) rotateZ(360deg);\r\n  }\r\n  to {\r\n    transform: translate(-50%, -50%) rotateZ(0deg);\r\n  }\r\n}\r\n\r\n@keyframes iconBounce {\r\n  0%, 100% {\r\n    transform: translateY(0);\r\n  }\r\n  50% {\r\n    transform: translateY(-6px);\r\n  }\r\n}\r\n\r\n@keyframes slideInLeft {\r\n  from {\r\n    opacity: 0;\r\n    transform: translateX(-30px);\r\n  }\r\n  to {\r\n    opacity: 1;\r\n    transform: translateX(0);\r\n  }\r\n}\r\n\r\n@keyframes slideInRight {\r\n  from {\r\n    opacity: 0;\r\n    transform: translateX(30px);\r\n  }\r\n  to {\r\n    opacity: 1;\r\n    transform: translateX(0);\r\n  }\r\n}\r\n\r\n@keyframes fadeInScale {\r\n  from {\r\n    opacity: 0;\r\n    transform: scale(0.95);\r\n  }\r\n  to {\r\n    opacity: 1;\r\n    transform: scale(1);\r\n  }\r\n}\r\n\r\n@keyframes fadeInUp {\r\n  from {\r\n    opacity: 0;\r\n    transform: translateY(20px);\r\n  }\r\n  to {\r\n    opacity: 1;\r\n    transform: translateY(0);\r\n  }\r\n}\r\n\r\n/* RESPONSIVE */\r\n@media (max-width: 1200px) {\r\n  .uc-use-cases-main-grid {\r\n    grid-template-columns: 1fr;\r\n    gap: 3rem;\r\n  }\r\n\r\n  .uc-center-rack-animation {\r\n    min-height: 400px;\r\n    margin: 2rem 0;\r\n  }\r\n\r\n  .uc-dc-rack-svg {\r\n    max-height: 400px;\r\n  }\r\n}\r\n\r\n@media (max-width: 768px) {\r\n  .uc-use-cases-hero {\r\n    padding: 4rem 1.5rem;\r\n  }\r\n\r\n  .uc-use-cases-header {\r\n    margin-bottom: 2.5rem;\r\n  }\r\n\r\n  .uc-use-cases-main-title {\r\n    font-size: clamp(2rem, 5vw, 2.8rem);\r\n    margin-bottom: 1rem;\r\n  }\r\n\r\n  .uc-use-cases-subtitle {\r\n    font-size: 0.95rem;\r\n  }\r\n\r\n  .uc-use-cases-column {\r\n    gap: 1.5rem;\r\n  }\r\n\r\n  .uc-use-case-card {\r\n    padding: 1.5rem;\r\n  }\r\n\r\n  .uc-card-icon-large {\r\n    font-size: 2rem;\r\n    min-width: 50px;\r\n    height: 50px;\r\n  }\r\n\r\n  .uc-card-title-large {\r\n    font-size: 1.1rem;\r\n  }\r\n\r\n  .uc-card-desc-large {\r\n    font-size: 0.9rem;\r\n  }\r\n\r\n  .uc-center-rack-animation {\r\n    min-height: 350px;\r\n  }\r\n\r\n  .uc-dc-rack-svg {\r\n    max-height: 350px;\r\n  }\r\n\r\n  .uc-use-cases-stats-section {\r\n    grid-template-columns: repeat(2, 1fr);\r\n    gap: 1.5rem;\r\n  }\r\n\r\n  .uc-stat-item {\r\n    padding: 1.5rem 1rem;\r\n  }\r\n\r\n  .uc-stat-value {\r\n    font-size: clamp(1.5rem, 3vw, 2rem);\r\n  }\r\n\r\n  .uc-use-cases-cta-buttons {\r\n    gap: 1rem;\r\n  }\r\n}\r\n\r\n@media (max-width: 480px) {\r\n  .uc-use-cases-hero {\r\n    padding: 3rem 1rem;\r\n  }\r\n\r\n  .uc-use-cases-main-title {\r\n    font-size: 1.8rem;\r\n    margin-bottom: 0.75rem;\r\n  }\r\n\r\n  .uc-use-cases-subtitle {\r\n    font-size: 0.9rem;\r\n  }\r\n\r\n  .uc-use-case-card {\r\n    padding: 1.25rem;\r\n  }\r\n\r\n  .uc-card-icon-large {\r\n    font-size: 1.8rem;\r\n    min-width: 45px;\r\n    height: 45px;\r\n  }\r\n\r\n  .uc-card-title-large {\r\n    font-size: 1rem;\r\n  }\r\n\r\n  .uc-card-desc-large {\r\n    font-size: 0.85rem;\r\n  }\r\n\r\n  .uc-center-rack-animation {\r\n    min-height: 280px;\r\n  }\r\n\r\n  .uc-dc-rack-svg {\r\n    max-height: 280px;\r\n  }\r\n\r\n  .uc-use-cases-stats-section {\r\n    grid-template-columns: 1fr;\r\n    gap: 1rem;\r\n  }\r\n\r\n  .uc-stat-item {\r\n    padding: 1.25rem 1rem;\r\n  }\r\n\r\n  .uc-stat-icon {\r\n    font-size: 2rem;\r\n    margin-bottom: 0.75rem;\r\n  }\r\n\r\n  .uc-stat-value {\r\n    font-size: 1.5rem;\r\n  }\r\n\r\n  .uc-stat-label {\r\n    font-size: 0.85rem;\r\n  }\r\n\r\n  .uc-use-cases-cta-buttons {\r\n    flex-direction: column;\r\n  }\r\n\r\n  .uc-btn-primary,\r\n  .uc-btn-secondary {\r\n    width: 100%;\r\n  }\r\n}\r\n\r\n/* ============================================================\r\n   INTELLIGENT OPERATIONS SECTION  (uc-iops-*)\r\n   ============================================================ */\r\n\r\n.uc-iops-section {\r\n  position: relative;\r\n  background: #060d1a;\r\n  overflow: hidden;\r\n  padding: clamp(4rem, 7vw, 7rem) clamp(1.5rem, 4vw, 4rem) 0;\r\n  border-top: 1px solid rgba(0,209,255,0.1);\r\n}\r\n\r\n/* ---- Background rings ---- */\r\n.uc-iops-rings {\r\n  position: absolute;\r\n  left: 50%;\r\n  top: 50%;\r\n  transform: translate(-50%, -46%);\r\n  pointer-events: none;\r\n  z-index: 0;\r\n}\r\n.uc-iops-ring {\r\n  position: absolute;\r\n  border-radius: 50%;\r\n  border: 1px solid rgba(0,209,255,0.07);\r\n  transform: translate(-50%, -50%);\r\n  left: 0; top: 0;\r\n}\r\n.uc-iops-ring.r1 { width: 820px; height: 820px; box-shadow: 0 0 0 1px rgba(0,209,255,0.04); }\r\n.uc-iops-ring.r2 { width: 600px; height: 600px; border-color: rgba(0,209,255,0.1); }\r\n.uc-iops-ring.r3 { width: 400px; height: 400px; border-color: rgba(0,209,255,0.14); }\r\n.uc-iops-ring.r4 { width: 220px; height: 220px; border-color: rgba(0,209,255,0.18); box-shadow: 0 0 40px rgba(0,209,255,0.06); }\r\n\r\n/* ---- 3-column layout ---- */\r\n.uc-iops-wrap {\r\n  position: relative;\r\n  z-index: 1;\r\n  max-width: 1400px;\r\n  margin: 0 auto;\r\n  display: grid;\r\n  grid-template-columns: 1fr 360px 1fr;\r\n  gap: clamp(2rem, 4vw, 4rem);\r\n  align-items: center;\r\n}\r\n\r\n/* ============================================================\r\n   LEFT COLUMN\r\n   ============================================================ */\r\n.uc-iops-left {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 1.6rem;\r\n}\r\n\r\n.uc-iops-brand {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 0.55rem;\r\n  font-size: 0.75rem;\r\n  font-weight: 700;\r\n  letter-spacing: 0.18em;\r\n  color: rgba(0,209,255,0.75);\r\n  border: 1px solid rgba(0,209,255,0.2);\r\n  border-radius: 8px;\r\n  padding: 0.4rem 0.9rem;\r\n  width: fit-content;\r\n  background: rgba(0,209,255,0.05);\r\n}\r\n\r\n.uc-iops-title {\r\n  margin: 0;\r\n  font-size: clamp(2rem, 3.2vw, 3.2rem);\r\n  font-weight: 820;\r\n  line-height: 1.12;\r\n  color: #fff;\r\n}\r\n\r\n.uc-iops-sub {\r\n  margin: 0;\r\n  font-size: clamp(0.92rem, 1.1vw, 1.05rem);\r\n  color: rgba(170,195,220,0.72);\r\n  line-height: 1.65;\r\n  max-width: 420px;\r\n}\r\n\r\n/* Feature list */\r\n.uc-iops-feats {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 1.1rem;\r\n}\r\n.uc-iops-feats li {\r\n  display: flex;\r\n  align-items: flex-start;\r\n  gap: 0.9rem;\r\n}\r\n.uc-iops-fi {\r\n  flex-shrink: 0;\r\n  width: 40px;\r\n  height: 40px;\r\n  border-radius: 10px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  padding: 8px;\r\n}\r\n.uc-iops-fi svg { width: 100%; height: 100%; }\r\n.uc-iops-fi.ai   { background: rgba(0,209,255,0.1);  border: 1px solid rgba(0,209,255,0.2); }\r\n.uc-iops-fi.vis  { background: rgba(68,136,255,0.1); border: 1px solid rgba(68,136,255,0.2); }\r\n.uc-iops-fi.rel  { background: rgba(155,124,255,0.1);border: 1px solid rgba(155,124,255,0.2); }\r\n.uc-iops-fi.sync { background: rgba(34,230,138,0.1); border: 1px solid rgba(34,230,138,0.2); }\r\n.uc-iops-fc {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 0.2rem;\r\n}\r\n.uc-iops-fc strong {\r\n  font-size: 0.97rem;\r\n  font-weight: 700;\r\n  color: #e2eeff;\r\n}\r\n.uc-iops-fc span {\r\n  font-size: 0.85rem;\r\n  color: rgba(160,190,220,0.65);\r\n  line-height: 1.5;\r\n}\r\n\r\n/* CTA buttons */\r\n/* ============================================================\r\n   CENTER – PHONE MOCKUP\r\n   ============================================================ */\r\n.uc-iops-center {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  gap: 1.75rem;\r\n}\r\n\r\n.uc-iops-cta-row {\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  gap: 1rem;\r\n  flex-wrap: wrap;\r\n  padding-bottom: 1rem;\r\n}\r\n\r\n.uc-iops-phone {\r\n  width: 310px;\r\n  background: #0b111f;\r\n  border-radius: 36px;\r\n  border: 1.5px solid rgba(255,255,255,0.12);\r\n  box-shadow:\r\n    0 0 0 6px rgba(0,0,0,0.4),\r\n    0 0 60px rgba(0,209,255,0.12),\r\n    0 40px 80px rgba(0,0,0,0.5);\r\n  overflow: hidden;\r\n  display: flex;\r\n  flex-direction: column;\r\n  position: relative;\r\n}\r\n/* notch */\r\n.uc-iops-phone::before {\r\n  content: '';\r\n  position: absolute;\r\n  top: 0;\r\n  left: 50%;\r\n  transform: translateX(-50%);\r\n  width: 90px;\r\n  height: 24px;\r\n  background: #0b111f;\r\n  border-bottom-left-radius: 12px;\r\n  border-bottom-right-radius: 12px;\r\n  z-index: 10;\r\n}\r\n\r\n/* Status bar */\r\n.uc-iops-sb {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  padding: 10px 18px 4px;\r\n  font-size: 0.7rem;\r\n  font-weight: 600;\r\n  color: rgba(255,255,255,0.9);\r\n  background: #0b111f;\r\n}\r\n.uc-iops-sb-icons {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 5px;\r\n}\r\n.uc-iops-batt {\r\n  width: 22px;\r\n  height: 11px;\r\n  border: 1.2px solid rgba(255,255,255,0.6);\r\n  border-radius: 2.5px;\r\n  position: relative;\r\n}\r\n.uc-iops-batt::after {\r\n  content: '';\r\n  position: absolute;\r\n  right: -4px;\r\n  top: 50%;\r\n  transform: translateY(-50%);\r\n  width: 3px;\r\n  height: 5px;\r\n  background: rgba(255,255,255,0.6);\r\n  border-radius: 0 1px 1px 0;\r\n}\r\n.uc-iops-batt::before {\r\n  content: '';\r\n  position: absolute;\r\n  inset: 2px;\r\n  right: 3px;\r\n  background: white;\r\n  border-radius: 1px;\r\n}\r\n\r\n/* App header */\r\n.uc-iops-app-hdr {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  padding: 8px 16px 10px;\r\n  background: #0d1524;\r\n  border-bottom: 1px solid rgba(255,255,255,0.06);\r\n}\r\n.uc-iops-app-logo {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  font-size: 0.85rem;\r\n  font-weight: 700;\r\n  color: #fff;\r\n}\r\n\r\n/* Scan row */\r\n.uc-iops-scan-row {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  padding: 10px 14px;\r\n  background: rgba(0,209,255,0.04);\r\n  border-bottom: 1px solid rgba(0,209,255,0.1);\r\n}\r\n.uc-iops-rack-ico { flex-shrink: 0; }\r\n.uc-iops-scan-meta {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 1px;\r\n  flex: 1;\r\n}\r\n.uc-iops-scan-name {\r\n  font-size: 0.78rem;\r\n  font-weight: 700;\r\n  color: #e2eeff;\r\n}\r\n.uc-iops-scan-id {\r\n  font-size: 0.68rem;\r\n  color: rgba(160,190,220,0.55);\r\n}\r\n.uc-iops-scan-badge {\r\n  font-size: 0.65rem;\r\n  font-weight: 700;\r\n  color: #00d1ff;\r\n  background: rgba(0,209,255,0.12);\r\n  border: 1px solid rgba(0,209,255,0.25);\r\n  border-radius: 20px;\r\n  padding: 3px 8px;\r\n  white-space: nowrap;\r\n}\r\n\r\n/* Viewfinder */\r\n.uc-iops-vf {\r\n  position: relative;\r\n  background: #080e1c;\r\n  margin: 0;\r\n  height: 200px;\r\n  overflow: hidden;\r\n}\r\n.uc-iops-vf-img {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n  object-position: center;\r\n  display: block;\r\n}\r\n.uc-iops-vf-overlay {\r\n  position: absolute;\r\n  inset: 0;\r\n  background: linear-gradient(\r\n    180deg,\r\n    rgba(0,10,25,0.25) 0%,\r\n    rgba(0,30,60,0.15) 50%,\r\n    rgba(0,10,25,0.35) 100%\r\n  );\r\n  mix-blend-mode: multiply;\r\n}\r\n/* corner brackets */\r\n.uc-iops-vf-corner {\r\n  position: absolute;\r\n  width: 20px;\r\n  height: 20px;\r\n}\r\n.uc-iops-vf-corner.tl { top: 8px; left: 8px; border-top: 2.5px solid #00d1ff; border-left: 2.5px solid #00d1ff; border-radius: 2px 0 0 0; }\r\n.uc-iops-vf-corner.tr { top: 8px; right: 8px; border-top: 2.5px solid #00d1ff; border-right: 2.5px solid #00d1ff; border-radius: 0 2px 0 0; }\r\n.uc-iops-vf-corner.bl { bottom: 8px; left: 8px; border-bottom: 2.5px solid #00d1ff; border-left: 2.5px solid #00d1ff; border-radius: 0 0 0 2px; }\r\n.uc-iops-vf-corner.br { bottom: 8px; right: 8px; border-bottom: 2.5px solid #00d1ff; border-right: 2.5px solid #00d1ff; border-radius: 0 0 2px 0; }\r\n\r\n/* Animated scan line */\r\n.uc-iops-scan-line {\r\n  position: absolute;\r\n  left: 8px; right: 8px;\r\n  height: 2px;\r\n  background: linear-gradient(90deg, transparent, #00d1ff 30%, #00d1ff 70%, transparent);\r\n  box-shadow: 0 0 12px rgba(0,209,255,0.7);\r\n  animation: iopsScanLine 2s ease-in-out infinite;\r\n}\r\n@keyframes iopsScanLine {\r\n  0%   { top: 10%; opacity: 1; }\r\n  90%  { top: 88%; opacity: 1; }\r\n  100% { top: 88%; opacity: 0; }\r\n}\r\n\r\n/* Camera controls */\r\n.uc-iops-cam {\r\n  display: flex;\r\n  justify-content: space-around;\r\n  align-items: center;\r\n  padding: 10px 24px;\r\n  background: #0b111f;\r\n  border-top: 1px solid rgba(255,255,255,0.05);\r\n}\r\n.uc-iops-shutter {\r\n  width: 44px;\r\n  height: 44px;\r\n  border-radius: 50%;\r\n  background: #1a6fd4;\r\n  box-shadow: 0 0 0 3px rgba(26,111,212,0.3), 0 0 20px rgba(0,150,255,0.4);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n}\r\n.uc-iops-shutter::after {\r\n  content: '';\r\n  width: 22px;\r\n  height: 22px;\r\n  border-radius: 50%;\r\n  background: rgba(255,255,255,0.15);\r\n  border: 1.5px solid rgba(255,255,255,0.4);\r\n}\r\n\r\n/* Progress bar */\r\n.uc-iops-prog {\r\n  padding: 10px 14px 8px;\r\n  background: #0d1524;\r\n  border-top: 1px solid rgba(255,255,255,0.05);\r\n}\r\n.uc-iops-prog-hd {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  margin-bottom: 6px;\r\n  font-size: 0.72rem;\r\n  font-weight: 600;\r\n  color: rgba(200,220,240,0.85);\r\n}\r\n.uc-iops-prog-pct { color: #00d1ff; }\r\n.uc-iops-prog-track {\r\n  height: 4px;\r\n  background: rgba(0,209,255,0.12);\r\n  border-radius: 4px;\r\n  overflow: hidden;\r\n  margin-bottom: 6px;\r\n}\r\n.uc-iops-prog-fill {\r\n  height: 100%;\r\n  width: 85%;\r\n  background: linear-gradient(90deg, #1a6fd4, #00d1ff);\r\n  border-radius: 4px;\r\n  position: relative;\r\n}\r\n.uc-iops-prog-fill::after {\r\n  content: '';\r\n  position: absolute;\r\n  right: 0;\r\n  top: -2px;\r\n  bottom: -2px;\r\n  width: 8px;\r\n  background: rgba(0,209,255,0.5);\r\n  filter: blur(4px);\r\n  animation: iopsProgGlow 1.5s ease-in-out infinite;\r\n}\r\n@keyframes iopsProgGlow {\r\n  0%, 100% { opacity: 0.6; }\r\n  50%       { opacity: 1; }\r\n}\r\n.uc-iops-prog-txt {\r\n  margin: 0;\r\n  font-size: 0.62rem;\r\n  color: rgba(160,190,220,0.5);\r\n}\r\n\r\n/* Bottom nav */\r\n.uc-iops-nav {\r\n  display: flex;\r\n  background: #0b111f;\r\n  border-top: 1px solid rgba(255,255,255,0.07);\r\n  padding: 6px 0 10px;\r\n}\r\n.uc-iops-nav-btn {\r\n  flex: 1;\r\n  background: none;\r\n  border: none;\r\n  cursor: pointer;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  gap: 2px;\r\n  padding: 4px 0;\r\n  font-size: 0.58rem;\r\n  color: rgba(160,190,220,0.45);\r\n  font-family: inherit;\r\n}\r\n.uc-iops-nav-btn.active { color: #00d1ff; }\r\n.uc-iops-nav-dot {\r\n  width: 18px;\r\n  height: 3px;\r\n  border-radius: 2px;\r\n  background: rgba(160,190,220,0.2);\r\n}\r\n.uc-iops-nav-btn.active .uc-iops-nav-dot {\r\n  background: #00d1ff;\r\n  box-shadow: 0 0 6px rgba(0,209,255,0.6);\r\n}\r\n\r\n/* ============================================================\r\n   RIGHT – STATUS CARDS\r\n   ============================================================ */\r\n.uc-iops-right {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 1rem;\r\n  position: relative;\r\n}\r\n\r\n.uc-iops-sc {\r\n  position: relative;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 0.85rem;\r\n  padding: 0.9rem 1rem;\r\n  background: rgba(10,20,40,0.85);\r\n  backdrop-filter: blur(12px);\r\n  border: 1px solid rgba(255,255,255,0.09);\r\n  border-left: 2px solid var(--sc-color, #00d1ff);\r\n  border-radius: 12px;\r\n  box-shadow: 0 4px 20px rgba(0,0,0,0.25);\r\n}\r\n/* dashed connector line pointing left toward phone */\r\n.uc-iops-sc::before {\r\n  content: '';\r\n  position: absolute;\r\n  right: 100%;\r\n  top: 50%;\r\n  transform: translateY(-50%);\r\n  width: clamp(20px, 3vw, 50px);\r\n  border-top: 2px dashed rgba(0,209,255,0.3);\r\n}\r\n/* dot at the connector start */\r\n.uc-iops-sc::after {\r\n  content: '';\r\n  position: absolute;\r\n  right: calc(100% + clamp(18px, 3vw, 48px));\r\n  top: 50%;\r\n  transform: translateY(-50%);\r\n  width: 7px;\r\n  height: 7px;\r\n  border-radius: 50%;\r\n  background: var(--sc-color, #00d1ff);\r\n  box-shadow: 0 0 8px var(--sc-color, #00d1ff);\r\n  animation: iopsDotPulse 2s ease-in-out infinite;\r\n}\r\n@keyframes iopsDotPulse {\r\n  0%, 100% { opacity: 1; transform: translateY(-50%) scale(1); }\r\n  50%       { opacity: 0.5; transform: translateY(-50%) scale(0.7); }\r\n}\r\n\r\n.uc-iops-sc-ico {\r\n  flex-shrink: 0;\r\n  width: 38px;\r\n  height: 38px;\r\n  border-radius: 10px;\r\n  background: rgba(255,255,255,0.05);\r\n  border: 1px solid rgba(255,255,255,0.08);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  color: var(--sc-color, #00d1ff);\r\n  padding: 7px;\r\n}\r\n.uc-iops-sc-ico svg { width: 100%; height: 100%; }\r\n\r\n.uc-iops-sc-body {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 1px;\r\n  flex: 1;\r\n}\r\n.uc-iops-sc-label {\r\n  font-size: 0.8rem;\r\n  font-weight: 800;\r\n  color: var(--sc-color, #00d1ff);\r\n  letter-spacing: 0.03em;\r\n}\r\n.uc-iops-sc-status {\r\n  font-size: 0.82rem;\r\n  font-weight: 500;\r\n  color: rgba(220,235,250,0.9);\r\n}\r\n.uc-iops-sc-time {\r\n  font-size