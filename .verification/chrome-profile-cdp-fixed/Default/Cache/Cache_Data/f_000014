ition: relative;\r\n  width: 100%;\r\n  height: 100%;\r\n  transform-style: preserve-3d;\r\n  transition: transform 0.65s cubic-bezier(0.4, 0.2, 0.2, 1);\r\n}\r\n\r\n.uc-flip-card:hover .uc-flip-inner {\r\n  transform: rotateY(180deg);\r\n}\r\n\r\n.uc-flip-front,\r\n.uc-flip-back {\r\n  position: absolute;\r\n  inset: 0;\r\n  backface-visibility: hidden;\r\n  -webkit-backface-visibility: hidden;\r\n  border-radius: 16px;\r\n  padding: 1.75rem 1.5rem 1.25rem;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  background: rgba(6, 18, 42, 0.88);\r\n  backdrop-filter: blur(16px);\r\n  border: 1.5px solid rgba(0, 209, 255, 0.18);\r\n  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3), inset 0 1px 0 rgba(255,255,255,0.04);\r\n  overflow: hidden;\r\n}\r\n\r\n.uc-flip-back {\r\n  transform: rotateY(180deg);\r\n  align-items: flex-start;\r\n}\r\n\r\n/* ---- FRONT FACE ---- */\r\n.uc-flip-front-icon {\r\n  font-size: 3rem;\r\n  margin-bottom: 1rem;\r\n  filter: drop-shadow(0 0 16px currentColor);\r\n  animation: iconBounce 3s ease-in-out infinite;\r\n}\r\n\r\n.uc-flip-front-value {\r\n  font-size: clamp(1.8rem, 2.5vw, 2.5rem);\r\n  font-weight: 800;\r\n  line-height: 1;\r\n  margin-bottom: 0.65rem;\r\n  background: linear-gradient(135deg, #00d1ff, #7ceeff);\r\n  -webkit-background-clip: text;\r\n  background-clip: text;\r\n  color: transparent;\r\n  -webkit-text-fill-color: transparent;\r\n}\r\n\r\n.uc-flip-front-label {\r\n  font-size: 0.95rem;\r\n  font-weight: 600;\r\n  color: #e2eeff;\r\n  text-align: center;\r\n  line-height: 1.4;\r\n  margin-bottom: 0.5rem;\r\n}\r\n\r\n.uc-flip-hint {\r\n  font-size: 0.78rem;\r\n  color: rgba(160, 190, 220, 0.5);\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 0.35rem;\r\n  padding-top: 0.5rem;\r\n}\r\n\r\n.uc-flip-spin-icon {\r\n  display: inline-block;\r\n  animation: flipSpinHint 3s ease-in-out infinite;\r\n}\r\n\r\n@keyframes flipSpinHint {\r\n  0%, 80%, 100% { transform: rotate(0deg); }\r\n  90% { transform: rotate(180deg); }\r\n}\r\n\r\n/* ---- FRONT FACE MINI VISUAL ---- */\r\n.uc-ffv-wrap {\r\n  flex: 1;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  width: 100%;\r\n  padding: 0.5rem 0;\r\n}\r\n\r\n.uc-ffv {\r\n  width: 100%;\r\n  max-width: 150px;\r\n  height: auto;\r\n  overflow: visible;\r\n}\r\n\r\n/* Gauge arc (target card) */\r\n.uc-ffv-arc {\r\n  stroke-dasharray: 181 183;\r\n  stroke-dashoffset: 183;\r\n  animation: ffvArc 1.6s cubic-bezier(0.4, 0, 0.2, 1) 0.3s forwards;\r\n}\r\n@keyframes ffvArc {\r\n  to { stroke-dashoffset: 0; }\r\n}\r\n\r\n/* Timeline progress line (clock card) */\r\n.uc-ffv-line {\r\n  stroke-dasharray: 124;\r\n  stroke-dashoffset: 124;\r\n  animation: ffvLine 1.8s ease-out 0.3s forwards;\r\n}\r\n@keyframes ffvLine {\r\n  to { stroke-dashoffset: 0; }\r\n}\r\n\r\n/* Bars (growth card) */\r\n.uc-ffv-bar {\r\n  transform-origin: bottom;\r\n  transform-box: fill-box;\r\n  animation: ffvBarGrow 0.9s cubic-bezier(0.34, 1.4, 0.64, 1) 0.2s both;\r\n}\r\n@keyframes ffvBarGrow {\r\n  from { transform: scaleY(0); opacity: 0; }\r\n  to   { transform: scaleY(1); opacity: 1; }\r\n}\r\n\r\n/* Sine wave (infinity card) */\r\n.uc-ffv-wave {\r\n  stroke-dasharray: 280;\r\n  stroke-dashoffset: 0;\r\n  animation: ffvWaveFlow 3s linear infinite;\r\n}\r\n@keyframes ffvWaveFlow {\r\n  0%   { stroke-dashoffset: 0; }\r\n  100% { stroke-dashoffset: -280; }\r\n}\r\n\r\n/* Pulsing dot (infinity card) */\r\n.uc-ffv-dot {\r\n  animation: ffvDotPulse 1.8s ease-in-out infinite;\r\n}\r\n@keyframes ffvDotPulse {\r\n  0%, 100% { opacity: 0.9; r: 5px; }\r\n  50%       { opacity: 0.5; r: 3px; }\r\n}\r\n\r\n/* Blinking status circles (infinity card) */\r\n.uc-ffv-blink {\r\n  animation: ffvBlink 2.2s ease-in-out infinite;\r\n}\r\n@keyframes ffvBlink {\r\n  0%, 100% { opacity: 1; }\r\n  50%       { opacity: 0.3; }\r\n}\r\n\r\n/* ---- BACK FACE ---- */\r\n.uc-flip-back-header {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 1rem;\r\n  width: 100%;\r\n  margin-bottom: 0.5rem;\r\n}\r\n\r\n.uc-flip-back-icon {\r\n  font-size: 2.2rem;\r\n  flex-shrink: 0;\r\n  filter: drop-shadow(0 0 12px currentColor);\r\n}\r\n\r\n.uc-flip-back-meta {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 2px;\r\n}\r\n\r\n.uc-flip-back-value {\r\n  font-size: 1.5rem;\r\n  font-weight: 800;\r\n  line-height: 1;\r\n}\r\n\r\n.uc-flip-back-label {\r\n  font-size: 0.82rem;\r\n  font-weight: 600;\r\n  line-height: 1.3;\r\n}\r\n\r\n.uc-flip-divider {\r\n  width: 100%;\r\n  height: 1px;\r\n  margin: 1rem 0;\r\n  background: rgba(0, 209, 255, 0.2);\r\n}\r\n\r\n.uc-flip-description {\r\n  font-size: 0.95rem;\r\n  color: rgba(190, 215, 235, 0.85);\r\n  line-height: 1.7;\r\n  font-weight: 300;\r\n  flex: 1;\r\n  margin: 0;\r\n}\r\n\r\n.uc-flip-back .uc-flip-hint {\r\n  align-self: flex-start;\r\n}\r\n\r\n/* ---- CARD VISUAL (back SVG illustration) ---- */\r\n.uc-flip-visual-wrap {\r\n  width: 100%;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  margin: 0.5rem 0 0.25rem;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.uc-flip-visual {\r\n  width: 100%;\r\n  max-width: 160px;\r\n  height: auto;\r\n  filter: drop-shadow(0 0 12px rgba(0, 209, 255, 0.18));\r\n}\r\n\r\n/* ---- CARD COLOR VARIANTS ---- */\r\n/* Target / Cyan */\r\n.uc-flip-target .uc-flip-front,\r\n.uc-flip-target .uc-flip-back {\r\n  border-color: rgba(0, 209, 255, 0.35);\r\n  box-shadow: 0 8px 40px rgba(0,0,0,0.3), 0 0 0 0 rgba(0,209,255,0), inset 0 1px 0 rgba(0,209,255,0.06);\r\n}\r\n.uc-flip-target:hover .uc-flip-front,\r\n.uc-flip-target:hover .uc-flip-back {\r\n  box-shadow: 0 8px 40px rgba(0,0,0,0.3), 0 0 30px rgba(0,209,255,0.15), inset 0 1px 0 rgba(0,209,255,0.08);\r\n  border-color: rgba(0, 209, 255, 0.6);\r\n}\r\n.uc-flip-target .uc-flip-back-value { color: #00D1FF; }\r\n.uc-flip-target .uc-flip-back-label { color: #7CEEFF; }\r\n.uc-flip-target .uc-flip-divider { background: rgba(0, 209, 255, 0.25); }\r\n\r\n/* Clock / Purple */\r\n.uc-flip-clock .uc-flip-front,\r\n.uc-flip-clock .uc-flip-back {\r\n  border-color: rgba(155, 124, 255, 0.35);\r\n}\r\n.uc-flip-clock:hover .uc-flip-front,\r\n.uc-flip-clock:hover .uc-flip-back {\r\n  box-shadow: 0 8px 40px rgba(0,0,0,0.3), 0 0 30px rgba(155,124,255,0.15), inset 0 1px 0 rgba(155,124,255,0.08);\r\n  border-color: rgba(155, 124, 255, 0.65);\r\n}\r\n.uc-flip-clock .uc-flip-front-value {\r\n  background: linear-gradient(135deg, #9B7CFF, #c4a8ff);\r\n  -webkit-background-clip: text;\r\n  background-clip: text;\r\n  color: transparent;\r\n  -webkit-text-fill-color: transparent;\r\n}\r\n.uc-flip-clock .uc-flip-back-value { color: #9B7CFF; }\r\n.uc-flip-clock .uc-flip-back-label { color: #c4a8ff; }\r\n.uc-flip-clock .uc-flip-divider { background: rgba(155, 124, 255, 0.25); }\r\n\r\n/* Growth / Blue */\r\n.uc-flip-growth .uc-flip-front,\r\n.uc-flip-growth .uc-flip-back {\r\n  border-color: rgba(68, 136, 255, 0.35);\r\n}\r\n.uc-flip-growth:hover .uc-flip-front,\r\n.uc-flip-growth:hover .uc-flip-back {\r\n  box-shadow: 0 8px 40px rgba(0,0,0,0.3), 0 0 30px rgba(68,136,255,0.15), inset 0 1px 0 rgba(68,136,255,0.08);\r\n  border-color: rgba(68, 136, 255, 0.65);\r\n}\r\n.uc-flip-growth .uc-flip-front-value {\r\n  background: linear-gradient(135deg, #4488FF, #88aaff);\r\n  -webkit-background-clip: text;\r\n  background-clip: text;\r\n  color: transparent;\r\n  -webkit-text-fill-color: transparent;\r\n}\r\n.uc-flip-growth .uc-flip-back-value { color: #4488FF; }\r\n.uc-flip-growth .uc-flip-back-label { color: #88aaff; }\r\n.uc-flip-growth .uc-flip-divider { background: rgba(68, 136, 255, 0.25); }\r\n\r\n/* Infinity / Green */\r\n.uc-flip-infinity .uc-flip-front,\r\n.uc-flip-infinity .uc-flip-back {\r\n  border-color: rgba(34, 230, 138, 0.35);\r\n}\r\n.uc-flip-infinity:hover .uc-flip-front,\r\n.uc-flip-infinity:hover .uc-flip-back {\r\n  box-shadow: 0 8px 40px rgba(0,0,0,0.3), 0 0 30px rgba(34,230,138,0.15), inset 0 1px 0 rgba(34,230,138,0.08);\r\n  border-color