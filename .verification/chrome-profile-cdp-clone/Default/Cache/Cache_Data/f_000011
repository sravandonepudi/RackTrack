const __vite__css = "/* ═══════════════════════════════════════════════════════════════════════════\r\n   RackTrack · Home Page  —  3D redesign\r\n   ═══════════════════════════════════════════════════════════════════════════ */\r\n\r\n.home-page {\r\n  --home-accent:    var(--accent-cyan);\r\n  --home-secondary: var(--accent-purple);\r\n  --home-glow:      var(--glow-cyan);\r\n  width: 100vw;\r\n  margin-left: calc(50% - 50vw);\r\n  text-align: left;\r\n}\r\n\r\n/* ══════════════════════════════════════════════════════════════════════════\r\n   HERO  —  two-column layout: text left, 3D rack right\r\n   ══════════════════════════════════════════════════════════════════════════ */\r\n.home-hero-section {\r\n  position: relative;\r\n  min-height: calc(100svh - 82px);\r\n  display: flex;\r\n  align-items: center;\r\n  padding: 0 clamp(24px, 5vw, 80px);\r\n  overflow: hidden;\r\n}\r\n\r\n.home-hero-inner {\r\n  position: relative;\r\n  z-index: 2;\r\n  display: grid;\r\n  grid-template-columns: 1fr 1fr;\r\n  gap: 48px;\r\n  align-items: center;\r\n  width: 100%;\r\n  max-width: 1400px;\r\n  margin: 0 auto;\r\n}\r\n\r\n.home-hero-content {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 28px;\r\n  max-width: 580px;\r\n}\r\n\r\n.home-hero-headline {\r\n  margin: 0;\r\n  color: #fff;\r\n  font-size: clamp(2.2rem, 3.8vw, 3.4rem);\r\n  font-weight: 800;\r\n  line-height: 1.1;\r\n}\r\n\r\n.home-hero-rack {\r\n  height: clamp(520px, calc(100svh - 100px), 920px);\r\n  border-radius: 12px;\r\n  overflow: hidden;\r\n}\r\n\r\n.home-hero-rack canvas {\r\n  display: block;\r\n  width: 100% !important;\r\n  height: 100% !important;\r\n}\r\n\r\n/* ── Shared typography ───────────────────────────────────────────────────── */\r\n.home-eyebrow {\r\n  color: var(--home-accent);\r\n  font-size: 0.72rem;\r\n  font-weight: 700;\r\n  letter-spacing: 0.18em;\r\n  text-transform: uppercase;\r\n  margin-bottom: 14px;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n\r\n.home-eyebrow::before {\r\n  content: '';\r\n  display: inline-block;\r\n  width: 20px;\r\n  height: 1px;\r\n  background: var(--home-accent);\r\n  box-shadow: 0 0 8px var(--accent-cyan);\r\n  flex-shrink: 0;\r\n}\r\n\r\n.home-section-heading {\r\n  max-width: 860px;\r\n  margin-bottom: 28px;\r\n}\r\n\r\n.home-section-heading h2,\r\n.home-final-cta h2 {\r\n  margin: 0 0 14px;\r\n  color: #fff;\r\n  font-size: 2.8rem;\r\n  line-height: 1.08;\r\n}\r\n\r\n.home-lede,\r\n.home-section-heading p,\r\n.home-card p,\r\n.home-final-cta p {\r\n  color: var(--text-secondary);\r\n  line-height: 1.7;\r\n}\r\n\r\n.home-lede {\r\n  max-width: 560px;\r\n  margin: 0;\r\n  font-size: 1.05rem;\r\n}\r\n\r\n/* ── Shared section wrapper ──────────────────────────────────────────────── */\r\n.home-section {\r\n  width: min(100% - 48px, 1320px);\r\n  margin: 0 auto;\r\n  padding: 80px 48px;\r\n}\r\n\r\n/* ── CTA buttons ─────────────────────────────────────────────────────────── */\r\n.home-actions {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  justify-content: flex-start;\r\n  gap: 14px;\r\n  margin-top: 8px;\r\n}\r\n\r\n.home-button {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  min-height: 46px;\r\n  padding: 12px 22px;\r\n  gap: 10px;\r\n  border: 1px solid rgba(139, 92, 246, 0.45);\r\n  border-radius: 8px;\r\n  background: rgba(11, 16, 38, 0.66);\r\n  color: #fff;\r\n  text-decoration: none;\r\n  font-weight: 700;\r\n  box-shadow: 0 0 24px rgba(139, 92, 246, 0.1);\r\n  transition: transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease;\r\n}\r\n\r\n.home-button:hover {\r\n  transform: translateY(-2px);\r\n  border-color: rgba(0, 240, 255, 0.54);\r\n  box-shadow: 0 0 32px rgba(0, 209, 255, 0.22);\r\n}\r\n\r\n.home-button.primary {\r\n  border-color: transparent;\r\n  background: var(--gradient-primary);\r\n  color: #fff;\r\n  box-shadow:\r\n    0 0 30px rgba(0, 209, 255, 0.28),\r\n    0 0 60px rgba(139, 92, 246, 0.16),\r\n    0 4px 16px rgba(0, 0, 0, 0.4);\r\n}\r\n\r\n.home-button.primary:hover {\r\n  box-shadow:\r\n    0 0 40px rgba(0, 209, 255, 0.4),\r\n    0 0 80px rgba(139, 92, 246, 0.22),\r\n    0 8px 24px rgba(0, 0, 0, 0.4);\r\n}\r\n\r\n/* ══════════════════════════════════════════════════════════════════════════\r\n   HERO  —  scroll-pinned 3D rack showcase\r\n   ══════════════════════════════════════════════════════════════════════════ */\r\n.home-rack-showcase {\r\n  --intro-title-opacity: 1;\r\n  --intro-title-y:       0px;\r\n  --intro-title-scale:   1;\r\n  --headline-opacity:    0;\r\n  --headline-y:          42px;\r\n  --copy-opacity:        1;\r\n  --copy-y:              0px;\r\n  --copy-scale:          1;\r\n  --assembly-x:          0px;\r\n  --assembly-y:          0px;\r\n  --assembly-rx:         0deg;\r\n  --assembly-ry:         0deg;\r\n  --rack-opacity:        0;\r\n  --rack-y:              92px;\r\n  --rack-rx:             -5deg;\r\n  --rack-ry:             -7deg;\r\n  --rack-scale:          1;\r\n  --installed-opacity:   0;\r\n  --scan-opacity:        0;\r\n  --scan-y:              0%;\r\n  --stage-opacity:       1;\r\n  position: relative;\r\n  min-height: 460svh;\r\n  width: 100vw;\r\n}\r\n\r\n.home-hero-local {\r\n  position: fixed;\r\n  top: 82px;\r\n  left: 0;\r\n  right: 0;\r\n  z-index: 2;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  min-height: calc(100svh - 82px);\r\n  height: calc(100svh - 82px);\r\n  width: 100vw;\r\n  opacity: var(--stage-opacity);\r\n  padding: 70px 44px 72px;\r\n  overflow: hidden;\r\n  text-align: center;\r\n  isolation: isolate;\r\n  pointer-events: auto;\r\n  will-change: opacity;\r\n}\r\n\r\n/* ── Ambient particle field ──────────────────────────────────────────────── */\r\n.hp-particles {\r\n  position: absolute;\r\n  inset: 0;\r\n  z-index: 0;\r\n  pointer-events: none;\r\n  overflow: hidden;\r\n}\r\n\r\n.hp-particle {\r\n  position: absolute;\r\n  left: var(--p-x, 50%);\r\n  bottom: -4px;\r\n  width: var(--p-size, 2px);\r\n  height: var(--p-size, 2px);\r\n  border-radius: 50%;\r\n  background: radial-gradient(circle, var(--accent-cyan) 0%, var(--accent-purple) 100%);\r\n  box-shadow: 0 0 8px var(--accent-cyan);\r\n  opacity: 0;\r\n  animation: hp-particle-rise var(--p-dur, 5s) var(--p-delay, 0s) ease-in infinite;\r\n}\r\n\r\n@keyframes hp-particle-rise {\r\n  0%   { transform: translateY(0)      scale(1);   opacity: 0; }\r\n  12%  { opacity: var(--p-opacity, 0.6); }\r\n  80%  { opacity: var(--p-opacity, 0.2); }\r\n  100% { transform: translateY(-88vh)  scale(0.2); opacity: 0; }\r\n}\r\n\r\n/* ── 3-D perspective grid floor ─────────────────────────────────────────── */\r\n.hp-floor {\r\n  position: absolute;\r\n  bottom: -60px;\r\n  left: 50%;\r\n  width: 1600px;\r\n  height: 900px;\r\n  transform: translateX(-50%) rotateX(74deg);\r\n  transform-origin: top center;\r\n  pointer-events: none;\r\n  z-index: 0;\r\n}\r\n\r\n.hp-floor-grid {\r\n  width: 100%;\r\n  height: 100%;\r\n  background-image:\r\n    linear-gradient(rgba(0, 209, 255, 0.14) 1px, transparent 1px),\r\n    linear-gradient(90deg, rgba(0, 209, 255, 0.14) 1px, transparent 1px),\r\n    linear-gradient(rgba(0, 209, 255, 0.04) 1px, transparent 1px),\r\n    linear-gradient(90deg, rgba(0, 209, 255, 0.04) 1px, transparent 1px);\r\n  background-size: 100px 100px, 100px 100px, 20px 20px, 20px 20px;\r\n  animation: hp-floor-breathe 5s ease-in-out infinite alternate;\r\n}\r\n\r\n@keyframes hp-floor-breathe {\r\n  0%   { opacity: 0.55; }\r\n  100% { opacity: 0.95; }\r\n}\r\n\r\n.hp-floor-fade {\r\n  position: absolute;\r\n  inset: 0;\r\n  background:\r\n    radial-gradient(ellipse 80% 55% at 50% 100%, var(--bg-primary) 0%, transparent 70%),\r\n    linear-gradient(to bottom, transparent 0%, var(--bg-primary) 88%);\r\n}\r\n\r\n/* ── Floating HUD status panels ─────────────────────────────────────────── */\r\n.hp-hud {\r\n  position: absolute;\r\n  z-index: 20;\r\n  min-width: 158px;\r\n  padding: 10px 14px 13px;\r\n  border: 1px solid rgba(0, 209, 255, 0.38);\r\n  border-radius: 8px;\r\n  background: rgba(4, 7, 20, 0.88);\r\n  backdrop-filter: blur(16px) saturate(1.4);\r\n  box-shadow:\r\n    0 0 0 1px rgba(0, 209, 255, 0.08),\r\n    0 0 28px rgba(0, 209, 255, 0.1),\r\n    inset 0 1px 0 rgba(255, 255, 255, 0.06);\r\n  opacity: var(--installed-opacity, 0);\r\n  pointer-events: none;\r\n}\r\n\r\n.hp-hud--tl { top: 17%; left: 3%; animation: hp-hud-float 3.4s ease-in-out infinite; }\r\n\r\n@keyframes hp-hud-float {\r\n  0%, 100% { transform: translateY(0px); }\r\n  50%       { transform: translateY(-5px); }\r\n}\r\n\r\n.hp-hud-header {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  margin-bottom: 7px;\r\n}\r\n\r\n.hp-hud-dot {\r\n  width: 6px;\r\n  height: 6px;\r\n  border-radius: 50%;\r\n  background: var(--accent-cyan);\r\n  box-shadow: 0 0 8px var(--accent-cyan);\r\n  flex-shrink: 0;\r\n  animation: hp-dot-blink 1.6s ease-in-out infinite;\r\n}\r\n\r\n@keyframes hp-dot-blink {\r\n  0%, 100% { opacity: 1; }\r\n  50%       { opacity: 0.18; }\r\n}\r\n\r\n.hp-hud-title {\r\n  color: var(--text-muted);\r\n  font-size: 0.52rem;\r\n  font-weight: 700;\r\n  letter-spacing: 0.14em;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.hp-hud-val {\r\n  color: var(--accent-cyan);\r\n  font-size: 1.15rem;\r\n  font-weight: 800;\r\n  letter-spacing: 0.04em;\r\n  line-height: 1;\r\n  margin-bottom: 9px;\r\n}\r\n.hp-hud-val em    { font-style: normal; font-size: 0.65rem; font-weight: 600; opacity: 0.68; margin-left: 2px; }\r\n.hp-hud-val--warn { color: #ff4056; }\r\n.hp-hud-val--ok   { color: #00ff8a; }\r\n\r\n.hp-hud-track {\r\n  height: 3px;\r\n  border-radius: 99px;\r\n  background: rgba(0, 209, 255, 0.14);\r\n  overflow: hidden;\r\n}\r\n.hp-hud-fill {\r\n  height: 100%;\r\n  width: var(--w, 50%);\r\n  border-radius: 99px;\r\n  background: var(--accent-cyan);\r\n  box-shadow: 0 0 10px var(--accent-cyan);\r\n}\r\n\r\n/* ── Hero copy overlay ───────────────────────────────────────────────────── */\r\n.home-hero-copy-local {\r\n  position: relative;\r\n  z-index: 12;\r\n  width: min(980px, 100%);\r\n  margin: 0 auto;\r\n  opacity: var(--copy-opacity);\r\n  transform: translate3d(0, var(--copy-y), 0) scale(var(--copy-scale));\r\n  transform-origin: center;\r\n  will-change: opacity, transform;\r\n}\r\n\r\n.home-title-swap {\r\n  position: relative;\r\n  display: grid;\r\n  align-items: center;\r\n  min-height: 220px;\r\n  margin: 0 auto 22px;\r\n}\r\n\r\n.home-title {\r\n  grid-area: 1 / 1;\r\n  max-width: 720px;\r\n  margin: 0 auto;\r\n  color: #fff;\r\n  font-size: 3.2rem;\r\n  line-height: 1.1;\r\n  text-align: center;\r\n  will-change: opacity, transform;\r\n}\r\n\r\n.home-title--brand {\r\n  font-size: clamp(3.1rem, 7.2vw, 6.6rem);\r\n  font-weight: 900;\r\n  letter-spacing: 0;\r\n  line-height: 0.9;\r\n  opacity: var(--intro-title-opacity);\r\n  background: linear-gradient(135deg, #ffffff 10%, var(--accent-cyan) 50%, var(--accent-purple) 90%);\r\n  background-clip: text;\r\n  -webkit-background-clip: text;\r\n  -webkit-text-fill-color: transparent;\r\n  text-transform: uppercase;\r\n  filter: drop-shadow(0 0 40px rgba(0, 209, 255, 0.4));\r\n  transform: translate3d(0, var(--intro-title-y), 0) scale(var(--intro-title-scale));\r\n}\r\n\r\n.home-title--headline {\r\n  opacity: var(--headline-opacity);\r\n  transform: translate3d(0, var(--headline-y), 0);\r\n}\r\n\r\n/* ══════════════════════════════════════════════════════════════════════════\r\n   3-D SCENE  —  device cards, rack, scan beam\r\n   ══════════════════════════════════════════════════════════════════════════ */\r\n.nd-scene {\r\n  position: absolute;\r\n  inset: 0;\r\n  z-index: 1;\r\n  overflow: hidden;\r\n  pointer-events: none;\r\n  perspective: 960px;\r\n  perspective-origin: 50% 44%;\r\n  transform-style: preserve-3d;\r\n}\r\n\r\n.nd-scene::before {\r\n  content: '';\r\n  position: absolute;\r\n  inset: auto 6% 5% 6%;\r\n  height: 240px;\r\n  border-radius: 50%;\r\n  background: radial-gradient(ellipse at center, rgba(0, 209, 255, 0.32), rgba(139, 92, 246, 0.18) 42%, transparent 68%);\r\n  filter: blur(40px);\r\n  opacity: var(--rack-opacity);\r\n}\r\n\r\n.rack-assembly {\r\n  position: absolute;\r\n  top: 50%;\r\n  left: 50%;\r\n  width: 0;\r\n  height: 0;\r\n  transform:\r\n    translate3d(var(--assembly-x), var(--assembly-y), 0)\r\n    rotateX(var(--assembly-rx))\r\n    rotateY(var(--assembly-ry));\r\n  transform-style: preserve-3d;\r\n  transform-origin: center;\r\n  will-change: transform;\r\n}\r\n\r\n.nd-motion-anchor {\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  width: 304px;\r\n  height: var(--device-h);\r\n  opacity: 0;\r\n  transform-style: preserve-3d;\r\n  will-change: transform, opacity;\r\n}\r\n\r\n/* ── Device card faces ───────────────────────────────────────────────────── */\r\n.nd-wrap {\r\n  width: 304px;\r\n  height: var(--device-h);\r\n  transform-style: preserve-3d;\r\n}\r\n\r\n.nd-card {\r\n  position: relative;\r\n  width: 100%;\r\n  height: 100%;\r\n  transform: rotateX(var(--nd-rx, -12deg)) rotateY(var(--nd-ry, 24deg)) rotateZ(var(--nd-rz, 0deg));\r\n  transform-style: preserve-3d;\r\n}\r\n\r\n.nd-face {\r\n  position: relative;\r\n  z-index: 3;\r\n  display: grid;\r\n  grid-template-columns: 48px minmax(0, 1fr);\r\n  grid-template-rows: minmax(0, 1fr) auto;\r\n  gap: 6px 10px;\r\n  width: 100%;\r\n  height: 100%;\r\n  padding: 9px 12px 8px;\r\n  border: 2px solid var(--nd-color);\r\n  border-radius: 7px;\r\n  background:\r\n    linear-gradient(180deg, color-mix(in srgb, var(--nd-color) 22%, transparent), transparent 36%),\r\n    linear-gradient(135deg, rgba(4, 8, 23, 0.82), rgba(3, 7, 20, 0.46));\r\n  box-shadow:\r\n    0 0 22px color-mix(in srgb, var(--nd-color) 62%, transparent),\r\n    0 0 56px color-mix(in srgb, var(--nd-color) 28%, transparent),\r\n    0 0 96px color-mix(in srgb, var(--nd-color) 12%, transparent),\r\n    inset 0 1px 0 rgba(255, 255, 255, 0.22),\r\n    inset 0 -18px 34px rgba(0, 0, 0, 0.28);\r\n  backdrop-filter: blur(8px) saturate(1.4);\r\n  transform: translateZ(22px);\r\n}\r\n\r\n.nd-face::before {\r\n  content: '';\r\n  position: absolute;\r\n  inset: 0 0 auto;\r\n  height: 6px;\r\n  border-radius: 6px 6px 0 0;\r\n  background: linear-gradient(90deg, var(--nd-color), color-mix(in srgb, var(--nd-color) 42%, transparent) 68%, transparent);\r\n  box-shadow: 0 0 20px var(--nd-color), 0 0 40px color-mix(in srgb, var(--nd-color) 50%, transparent);\r\n}\r\n\r\n.nd-extrude-top,\r\n.nd-extrude-right,\r\n.nd-extrude-bottom {\r\n  position: absolute;\r\n  pointer-events: none;\r\n  border: 1.5px solid color-mix(in srgb, var(--nd-color) 52%, transparent);\r\n  box-shadow: 0 0 12px color-mix(in srgb, var(--nd-color) 28%, transparent);\r\n}\r\n\r\n.nd-extrude-top {\r\n  top: -18px; left: 9px; right: -11px; height: 22px;\r\n  border-radius: 6px 7px 1px 1px;\r\n  background: linear-gradient(180deg, color-mix(in srgb, var(--nd-color) 52%, #050816), color-mix(in srgb, var(--nd-color) 24%, #050816) 60%, rgba(5, 8, 22, 0.62));\r\n  transform: rotateX(68deg) translateZ(8px);\r\n  transform-origin: bottom center;\r\n}\r\n\r\n.nd-extrude-right {\r\n  top: -2px; right: -16px; bottom: -11px; width: 20px;\r\n  border-radius: 0 7px 7px 0;\r\n  background: linear-gradient(90deg, color-mix(in srgb, var(--nd-color) 32%, #050816), color-mix(in srgb, var(--nd-color) 14%, #050816) 50%, rgba(0, 0, 0, 0.78));\r\n  transform: rotateY(70deg) translateZ(2px);\r\n  transform-origin: left center;\r\n}\r\n\r\n.nd-extrude-bottom {\r\n  right: -8px; bottom: -18px; left: 8px; height: 22px;\r\n  border-radius: 0 0 7px 7px;\r\n  background: linear-gradient(0deg, color-mix(in srgb, var(--nd-color) 22%, #020510), rgba(0, 0, 0, 0.82));\r\n  transform: rotateX(-68deg) translateZ(5px);\r\n  transform-origin: top center;\r\n}\r\n\r\n.nd-leds {\r\n  position: relative;\r\n  z-index: 1;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 5px;\r\n  grid-column: 1;\r\n  grid-row: 1;\r\n  align-self: start;\r\n  margin-top: 6px;\r\n}\r\n\r\n.nd-led { width: 7px; height: 7px; border-radius: 50%; background: var(--nd-color); }\r\n.nd-led--on    { box-shadow: 0 0 6px var(--nd-color), 0 0 14px var(--nd-color); }\r\n.nd-led--blink { animation: nd-blink 1.45s ease-in-out infinite; }\r\n.nd-led--off   { opacity: 0.18; }\r\n\r\n.nd-ports {\r\n  position: relative;\r\n  z-index: 1;\r\n  display: grid;\r\n  grid-column: 2;\r\n  grid-row: 1;\r\n  grid-template-columns: repeat(10, minmax(0, 1fr));\r\n  align-self: center;\r\n  gap: 4px;\r\n}\r\n\r\n.nd-port {\r\n  display: block;\r\n  height: 8px;\r\n  border: 1px solid color-mix(in srgb, var(--nd-color) 82%, #ffffff);\r\n  border-radius: 2px;\r\n  background: rgba(0, 0, 0, 0.58);\r\n  box-shadow: inset 0 0 5px rgba(0, 0, 0, 0.92), 0 0 4px color-mix(in srgb, var(--nd-color) 40%, transparent);\r\n}\r\n\r\n.nd-meta {\r\n  position: relative;\r\n  z-index: 1;\r\n  display: flex;\r\n  grid-column: 1 / -1;\r\n  grid-row: 2;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  min-width: 0;\r\n  gap: 10px;\r\n}\r\n\r\n.nd-label {\r\n  min-width: 0;\r\n  overflow: hidden;\r\n  color: var(--nd-color);\r\n  font-size: 0.56rem;\r\n  font-weight: 800;\r\n  letter-spacing: 0.14em;\r\n  line-height: 1;\r\n  text-overflow: ellipsis;\r\n  text-shadow: 0 0 10px var(--nd-color), 0 0 22px var(--nd-color);\r\n  text-transform: uppercase;\r\n  white-space: nowrap;\r\n}\r\n\r\n.nd-glyph {\r\n  flex: 0 0 auto;\r\n  color: var(--nd-color);\r\n  font-size: 0.92rem;\r\n  font-weight: 900;\r\n  letter-spacing: 0;\r\n  line-height: 1;\r\n  text-shadow: 0 0 10px var(--nd-color), 0 0 24px var(--nd-color);\r\n}\r\n\r\n/* ── Rack frame ──────────────────────────────────────────────────────────── */\r\n.rack-dock {\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  z-index: 2;\r\n  width: var(--rack-width);\r\n  height: var(--rack-height);\r\n  opacity: var(--rack-opacity);\r\n  filter:\r\n    drop-shadow(0 0 44px rgba(0, 209, 255, 0.42))\r\n    drop-shadow(0 0 88px rgba(0, 209, 255, 0.2))\r\n    drop-shadow(0 32px 64px rgba(0, 0, 0, 0.74));\r\n  transform:\r\n    translate3d(-50%, calc(-50% + var(--rack-y)), -84px)\r\n    rotateX(var(--rack-rx))\r\n    rotateY(var(--rack-ry))\r\n    scale(var(--rack-scale));\r\n  transform-style: preserve-3d;\r\n  transform-origin: center;\r\n  will-change: opacity, transform;\r\n}\r\n\r\n.rack-front {\r\n  position: absolute;\r\n  inset: 0;\r\n  border: 2px solid rgba(0, 209, 255, 0.88);\r\n  border-radius: 8px;\r\n  background:\r\n    linear-gradient(90deg, rgba(0, 209, 255, 0.18), transparent 14% 86%, rgba(139, 92, 246, 0.16)),\r\n    rgba(4, 8, 23, 0.52);\r\n  box-shadow:\r\n    0 0 0 1px rgba(0, 209, 255, 0.22),\r\n    inset 0 0 0 1px rgba(255, 255, 255, 0.1),\r\n    inset 0 0 42px rgba(0, 209, 255, 0.12),\r\n    0 0 32px rgba(0, 209, 255, 0.28),\r\n    0 0 64px rgba(0, 209, 255, 0.12);\r\n  transform: translateZ(5px);\r\n  transform-style: preserve-3d;\r\n  overflow: hidden;\r\n}\r\n\r\n.rack-depth {\r\n  position: absolute;\r\n  border: 1.5px solid rgba(0, 209, 255, 0.55);\r\n  background: linear-gradient(135deg, rgba(0, 209, 255, 0.22), rgba(5, 8, 22, 0.82));\r\n  box-shadow: inset 0 0 24px rgba(0, 209, 255, 0.1), 0 0 18px rgba(0, 209, 255, 0.22);\r\n}\r\n\r\n.rack-depth--top {\r\n  top: calc(var(--rack-depth) * -0.62); right: calc(var(--rack-depth) * -0.7); left: calc(var(--rack-depth) * 0.28);\r\n  height: var(--rack-depth);\r\n  border-radius: 6px 8px 0 0;\r\n  background: linear-gradient(180deg, rgba(0, 209, 255, 0.32), rgba(0, 180, 230, 0.12) 60%, rgba(5, 8, 22, 0.75));\r\n  transform: rotateX(68deg);\r\n  transform-origin: bottom center;\r\n}\r\n\r\n.rack-depth--right {\r\n  top: calc(var(--rack-depth) * -0.28); right: calc(var(--rack-depth) * -0.82); bottom: calc(var(--rack-depth) * -0.18);\r\n  width: var(--rack-depth);\r\n  border-radius: 0 8px 8px 0;\r\n  border-color: rgba(139, 92, 246, 0.65);\r\n  background: linear-gradient(90deg, rgba(139, 92, 246, 0.28), rgba(100, 60, 200, 0.14) 50%, rgba(0, 0, 0, 0.82));\r\n  box-shadow: inset 0 0 24px rgba(139, 92, 246, 0.16), 0 0 22px rgba(139, 92, 246, 0.28);\r\n  transform: rotateY(68deg);\r\n  transform-origin: left center;\r\n}\r\n\r\n.rack-depth--bottom {\r\n  right: calc(var(--rack-depth) * -0.56); bottom: calc(var(--rack-depth) * -0.62); left: calc(var(--rack-depth) * 0.1);\r\n  height: var(--rack-depth);\r\n  border-radius: 0 0 8px 8px;\r\n  background: linear-gradient(180deg, rgba(0, 0, 0, 0.82), rgba(0, 209, 255, 0.16) 80%, rgba(0, 209, 255, 0.24));\r\n  transform: rotateX(-68deg);\r\n  transform-origin: top center;\r\n}\r\n\r\n.rack-backplane {\r\n  position: absolute;\r\n  inset: 34px var(--rack-slot-inset) 42px;\r\n  border-radius: 4px;\r\n  background:\r\n    repeating-linear-gradient(180deg, rgba(0, 209, 255, 0.1) 0 1px, transparent 1px 22px),\r\n    linear-gradient(180deg, rgba(0, 0, 0, 0.36), rgba(0, 0, 0, 0.1));\r\n  box-shadow: inset 0 0 26px rgba(0, 0, 0, 0.45);\r\n  transform: translateZ(-22px);\r\n}\r\n\r\n.rack-slot {\r\n  position: absolute;\r\n  right: var(--rack-slot-inset);\r\n  left: var(--rack-slot-inset);\r\n  border: 1px dashed rgba(0, 209, 255, 0.16);\r\n  border-radius: 5px;\r\n  background: rgba(0, 209, 255, 0.035);\r\n  transform: translateZ(-10px);\r\n}\r\n\r\n.rack-installed-devices {\r\n  position: absolute;\r\n  inset: 0;\r\n  z-index: 5;\r\n  opacity: var(--installed-opacity);\r\n  pointer-events: none;\r\n  transform: translateZ(34px);\r\n  transform-style: preserve-3d;\r\n  will-change: opacity;\r\n}\r\n\r\n.rack-installed-device {\r\n  position: absolute;\r\n  right: var(--rack-slot-inset);\r\n  left: var(--rack-slot-inset);\r\n  transform-style: preserve-3d;\r\n}\r\n\r\n.rack-installed-device .nd-wrap  { width: 100%; }\r\n.rack-installed-device .nd-extrude-right { right: -10px; width: 14px; }\r\n\r\n.rack-rail {\r\n  position: absolute;\r\n  top: 18px; bottom: 18px;\r\n  z-index: 2;\r\n  display: flex;\r\n  flex-direction: column;\r\n  justify-content: space-between;\r\n  width: 28px;\r\n  padding: 8px 7px;\r\n  border: 1.5px solid rgba(0, 209, 255, 0.72);\r\n  border-radius: 5px;\r\n  background: linear-gradient(180deg, rgba(0, 209, 255, 0.22), rgba(0, 180, 240, 0.1) 50%, rgba(0, 0, 0, 0.52));\r\n  box-shadow:\r\n    inset 0 0 22px rgba(0, 209, 255, 0.14),\r\n    0 0 18px rgba(0, 209, 255, 0.32),\r\n    0 0 36px rgba(0, 209, 255, 0.14);\r\n  transform: translateZ(22px);\r\n}\r\n\r\n.rack-rail--left  { left: 14px; }\r\n.rack-rail--right { right: 14px; }\r\n\r\n.rack-rail span {\r\n  display: block;\r\n  width: 12px;\r\n  height: 6px;\r\n  border-radius: 2px;\r\n  background: rgba(0, 209, 255, 0.46);\r\n  box-shadow: 0 0 10px rgba(0, 209, 255, 0.52), 0 0 20px rgba(0, 209, 255, 0.22);\r\n}\r\n\r\n/* ── Scan beam ───────────────────────────────────────────────────────────── */\r\n.rack-scan {\r\n  position: absolute;\r\n  top: 50%;\r\n  left: 50%;\r\n  z-index: 40;\r\n  width: calc(var(--rack-width) * var(--rack-scale));\r\n  height: 96px;\r\n  opacity: var(--scan-opacity);\r\n  background:\r\n    linear-gradient(180deg, transparent 0%, rgba(0, 240, 255, 0.18) 28%, rgba(0, 240, 255, 0.84) 50%, rgba(0, 240, 255, 0.18) 72%, transparent 100%),\r\n    linear-gradient(90deg, transparent 0%, rgba(0, 240, 255, 0.58) 12%, rgba(255, 255, 255, 0.72) 50%, rgba(0, 240, 255, 0.58) 88%, transparent 100%);\r\n  border-top: 1px solid rgba(180, 255, 255, 0.92);\r\n  border-bottom: 1px solid rgba(0, 240, 255, 0.44);\r\n  filter: drop-shadow(0 0 16px rgba(0, 240, 255, 0.9)) drop-shadow(0 0 42px rgba(0, 209, 255, 0.36));\r\n  mix-blend-mode: screen;\r\n  transform:\r\n    translate3d(\r\n      -50%,\r\n      calc(-50% + var(--rack-y) - (var(--rack-height) * var(--rack-scale) / 2) + var(--scan-y) * var(--rack-height) * var(--rack-scale)),\r\n      260px\r\n    )\r\n    rotateX(var(--rack-rx))\r\n    rotateY(var(--rack-ry));\r\n  will-change: opacity, transform;\r\n}\r\n\r\n/* ══════════════════════════════════════════════════════════════════════════\r\n   SHARED ANIMATIONS\r\n   ══════════════════════════════════════════════════════════════════════════ */\r\n@keyframes nd-blink {\r\n  0%, 100% { opacity: 1; box-shadow: 0 0 6px var(--nd-color); }\r\n  50%       { opacity: 0.08; box-shadow: none; }\r\n}\r\n\r\n/* ── Scroll-reveal ───────────────────────────────────────────────────────── */\r\n.home-reveal {\r\n  opacity: 0;\r\n  transform: translateY(36px);\r\n  transition: opacity 0.7s ease, transform 0.7s ease;\r\n}\r\n.home-reveal.is-visible {\r\n  opacity: 1;\r\n  transform: translateY(0);\r\n}\r\n\r\n/* ══════════════════════════════════════════════════════════════════════════\r\n   PROBLEM SECTION  —  3D stat cards\r\n   ══════════════════════════════════════════════════════════════════════════ */\r\n.home-section--problem {\r\n  position: relative;\r\n  z-index: 3;\r\n  width: min(100% - 48px, 1320px);\r\n  max-width: none;\r\n  margin: 0 auto 80px;\r\n  padding: 56px 48px;\r\n  border: 1px solid rgba(0, 209, 255, 0.18);\r\n  border-radius: 16px;\r\n  background: linear-gradient(145deg, rgba(0, 209, 255, 0.09), rgba(5, 8, 22, 0.82) 52%, rgba(139, 92, 246, 0.08));\r\n  box-shadow:\r\n    0 32px 80px rgba(0, 0, 0, 0.38),\r\n    inset 0 1px 0 rgba(255, 255, 255, 0.06),\r\n    0 0 60px rgba(0, 209, 255, 0.04);\r\n  backdrop-filter: blur(12px);\r\n}\r\n\r\n.hp-problem-glow {\r\n  position: absolute;\r\n  inset: -60px;\r\n  z-index: -1;\r\n  border-radius: 50%;\r\n  background: radial-gradient(ellipse at 30% 50%, rgba(0, 209, 255, 0.06), transparent 60%);\r\n  pointer-events: none;\r\n}\r\n\r\n.home-section--problem .home-section-heading { max-width: 100%; }\r\n\r\n.home-section--problem .home-stat-grid {\r\n  grid-template-columns: repeat(5, minmax(92px, 1fr));\r\n  gap: 12px;\r\n}\r\n\r\n/* ── Stat grid ───────────────────────────────────────────────────────────── */\r\n.home-stat-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(5, minmax(0, 1fr));\r\n  gap: 14px;\r\n  margin-top: 32px;\r\n}\r\n\r\n.home-stat {\r\n  position: relative;\r\n  padding: 20px 16px 18px;\r\n  border: 1px solid rgba(0, 209, 255, 0.14);\r\n  border-radius: 10px;\r\n  background:\r\n    radial-gradient(ellipse at 50% 0%, rgba(0, 209, 255, 0.07), transparent 60%),\r\n    rgba(8, 12, 30, 0.72);\r\n  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.28);\r\n  overflow: hidden;\r\n  transition: border-color 200ms ease, box-shadow 200ms ease, transform 200ms ease;\r\n}\r\n\r\n.home-stat:hover {\r\n  border-color: rgba(0, 209, 255, 0.38);\r\n  box-shadow: 0 0 32px rgba(0, 209, 255, 0.12), 0 12px 40px rgba(0, 0, 0, 0.36);\r\n  transform: translateY(-2px);\r\n}\r\n\r\n/* Animated top accent bar */\r\n.home-stat-bar {\r\n  position: absolute;\r\n  top: 0; left: 0; right: 0;\r\n  height: 2px;\r\n  background: linear-gradient(90deg, var(--accent-cyan), var(--accent-purple) 60%, transparent);\r\n  border-radius: 2px 2px 0 0;\r\n  box-shadow: 0 0 12px rgba(0, 209, 255, 0.45);\r\n  animation: hp-bar-glow 3s ease-in-out calc(var(--stat-i, 0) * 0.5s) infinite alternate;\r\n}\r\n\r\n@keyframes hp-bar-glow {\r\n  0%   { opacity: 0.55; box-shadow: 0 0 6px rgba(0, 209, 255, 0.3); }\r\n  100% { opacity: 1;    box-shadow: 0 0 20px rgba(0, 209, 255, 0.7), 0 0 40px rgba(139, 92, 246, 0.3); }\r\n}\r\n\r\n.home-stat strong {\r\n  display: block;\r\n  margin-bottom: 8px;\r\n  color: var(--accent-cyan);\r\n  font-size: 1.35rem;\r\n  font-weight: 800;\r\n  line-height: 1.1;\r\n  text-shadow: 0 0 20px rgba(0, 209, 255, 0.4);\r\n}\r\n\r\n.home-stat span {\r\n  color: var(--text-secondary);\r\n  font-size: 0.82rem;\r\n  line-height: 1.5;\r\n}\r\n\r\n/* ══════════════════════════════════════════════════════════════════════════\r\n   WHAT SECTION\r\n   ══════════════════════════════════════════════════════════════════════════ */\r\n.home-section--what {\r\n  position: relative;\r\n  z-index: 3;\r\n  width: min(100% - 48px, 1320px);\r\n  margin: 0 auto;\r\n  padding: 80px 48px;\r\n}\r\n\r\n/* Decorative orbital rings */\r\n.hp-what-badge {\r\n  position: absolute;\r\n  top: 80px;\r\n  left: -64px;\r\n  width: 80px;\r\n  height: 80px;\r\n  pointer-events: none;\r\n}\r\n\r\n.hp-what-badge-ring {\r\n  position: absolute;\r\n  inset: 0;\r\n  border-radius: 50%;\r\n  border: 1px solid rgba(0, 209, 255, 0.28);\r\n  animation: hp-ring-spin 12s linear infinite;\r\n}\r\n\r\n.hp-what-badge-ring--2 {\r\n  inset: 10px;\r\n  border-color: rgba(139, 92, 246, 0.22);\r\n  animation-direction: reverse;\r\n  animation-duration: 8s;\r\n}\r\n\r\n@keyframes hp-ring-spin {\r\n  from { transform: rotate(0deg); }\r\n  to   { transform: rotate(360deg); }\r\n}\r\n\r\n/* ── Positioning callout ─────────────────────────────────────────────────── */\r\n.home-positioning {\r\n  display: inline-block;\r\n  margin-top: 10px;\r\n  padding: 10px 20px;\r\n  border: 1px solid rgba(139, 92, 246, 0.4);\r\n  border-radius: 6px;\r\n  background: rgba(139, 92, 246, 0.07);\r\n  color: rgba(255, 255, 255, 0.72);\r\n  font-size: 0.95rem;\r\n  font-style: italic;\r\n  box-shadow: 0 0 20px rgba(139, 92, 246, 0.06);\r\n}\r\n\r\n/* ══════════════════════════════════════════════════════════════════════════\r\n   CAPABILITIES  —  sticky animated 4×2 grid with 3D tilt\r\n   ══════════════════════════════════════════════════════════════════════════ */\r\n.cap-section {\r\n  padding: 80px 0;\r\n  width: 100%;\r\n  max-width: 100%;\r\n}\r\n\r\n.cap-sticky-wrap {\r\n  display: flex;\r\n  flex-direction: column;\r\n  padding: 0 clamp(24px, 4vw, 64px);\r\n}\r\n\r\n.cap-section .home-section-heading {\r\n  margin-bottom: 36px;\r\n  max-width: min(100% - 48px, 1320px);\r\n}\r\n\r\n/* 3+3+2 grid layout */\r\n.cap-grid-stack {\r\n  display: grid;\r\n  grid-template-columns: repeat(6, minmax(0, 1fr));\r\n  gap: 16px;\r\n  width: min(100% - 48px, 1320px);\r\n  max-width: none;\r\n}\r\n\r\n.cap-card:nth-child(1) { grid-column: 1 / 3; }\r\n.cap-card:nth-child(2) { grid-column: 3 / 5; }\r\n.cap-card:nth-child(3) { grid-column: 5 / 7; }\r\n.cap-card:nth-child(4) { grid-column: 1 / 3; }\r\n.cap-card:nth-child(5) { grid-column: 3 / 5; }\r\n.cap-card:nth-child(6) { grid-column: 5 / 7; }\r\n.cap-card:nth-child(7) { grid-column: 2 / 4; }\r\n.cap-card:nth-child(8) { grid-column: 4 / 6; }\r\n\r\n.cap-card {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 12px;\r\n  padding: 22px 20px 24px;\r\n  border: 1px solid rgba(0, 209, 255, 0.16);\r\n  border-radius: 10px;\r\n  background:\r\n    radial-gradient(circle at var(--gx, 50%) var(--gy, 0%), rgba(0, 209, 255, 0.1), transparent 60%),\r\n    linear-gradient(155deg, rgba(13, 21, 45, 0.97), rgba(6, 9, 24, 0.97) 60%, rgba(20, 15, 45, 0.97));\r\n  box-shadow:\r\n    0 14px 40px rgba(0, 0, 0, 0.48),\r\n    0 0 22px rgba(0, 209, 255, 0.05),\r\n    inset 0 1px 0 rgba(255, 255, 255, 0.07);\r\n  backdrop-filter: blur(10px);\r\n  transition: border-color 200ms ease, box-shadow 200ms ease;\r\n  overflow: hidden;\r\n}\r\n\r\n.cap-card.is-visible {\r\n  opacity: 1;\r\n}\r\n\r\n.cap-card-icon {\r\n  font-size: 1.4rem;\r\n  line-height: 1;\r\n  color: var(--accent-cyan);\r\n  text-shadow: 0 0 12px rgba(0, 209, 255, 0.55);\r\n  flex-shrink: 0;\r\n}\r\n\r\n.cap-card-body { width: 100%; min-width: 0; }\r\n\r\n.cap-card-body h3 {\r\n  margin: 0 0 7px;\r\n  color: var(--accent-cyan);\r\n  font-size: 0.72rem;\r\n  font-weight: 800;\r\n  letter-spacing: 0.12em;\r\n  line-height: 1.3;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.cap-card-body p {\r\n  margin: 0;\r\n  color: var(--text-secondary);\r\n  font-size: 0.86rem;\r\n  line-height: 1.6;\r\n}\r\n\r\n/* ══════════════════════════════════════════════════════════════════════════\r\n   3D CARD TILT  —  interactive perspective on hover\r\n   ══════════════════════════════════════════════════════════════════════════ */\r\n.hp-tilt {\r\n  --tx: 0deg;\r\n  --ty: 0deg;\r\n  --gx: 50%;\r\n  --gy: 50%;\r\n  transform-style: preserve-3d;\r\n  transform:\r\n    perspective(700px)\r\n    rotateX(var(--tx))\r\n    rotateY(var(--ty))\r\n    translateY(var(--card-y, 0px))\r\n    scale(var(--card-scale, 1));\r\n  transition:\r\n    transform 0.18s ease-out,\r\n    border-color 200ms ease,\r\n    box-shadow 200ms ease;\r\n}\r\n\r\n/* Override the non-tilt transform on cap-card */\r\n.cap-card.hp-tilt {\r\n  transform:\r\n    perspective(700px)\r\n    rotateX(var(--tx, 0deg))\r\n    rotateY(var(--ty, 0deg));\r\n  transition:\r\n    transform 0.18s ease-out,\r\n    border-color 200ms ease,\r\n    box-shadow 200ms ease;\r\n}\r\n\r\n.hp-tilt:hover {\r\n  border-color: rgba(0, 209, 255, 0.36);\r\n  box-shadow:\r\n    0 14px 40px rgba(0, 0, 0, 0.48),\r\n    0 0 36px rgba(0, 209, 255, 0.14),\r\n    inset 0 1px 0 rgba(255, 255, 255, 0.1);\r\n}\r\n\r\n/* ══════════════════════════════════════════════════════════════════════════\r\n   PROOF TABLE  —  holographic comparison display\r\n   ══════════════════════════════════════════════════════════════════════════ */\r\n.home-section--proof {\r\n  width: min(100% - 48px, 1320px);\r\n  max-width: none;\r\n  margin: 0 auto;\r\n  padding: 72px 48px;\r\n}\r\n\r\n.home-section--proof .home-section-heading { max-width: 100%; }\r\n\r\n.home-proof-table {\r\n  position: relative;\r\n  margin-top: 24px;\r\n  border: 1px solid rgba(0, 209, 255, 0.22);\r\n  border-radius: 12px;\r\n  overflow: hidden;\r\n  background: linear-gradient(160deg, rgba(0, 209, 255, 0.06), rgba(5, 8, 22, 0.88) 50%, rgba(139, 92, 246, 0.05));\r\n  box-shadow:\r\n    0 28px 70px rgba(0, 0, 0, 0.4),\r\n    inset 0 1px 0 rgba(255, 255, 255, 0.06),\r\n    0 0 0 1px rgba(0, 209, 255, 0.06);\r\n  backdrop-filter: blur(12px);\r\n}\r\n\r\n/* CRT scanline texture overlay */\r\n.hp-proof-scanlines {\r\n  position: absolute;\r\n  inset: 0;\r\n  z-index: 2;\r\n  pointer-events: none;\r\n  background: repeating-linear-gradient(\r\n    0deg,\r\n    transparent,\r\n    transparent 2px,\r\n    rgba(0, 209, 255, 0.018) 2px,\r\n    rgba(0, 209, 255, 0.018) 3px\r\n  );\r\n  border-radius: 12px;\r\n}\r\n\r\n.home-proof-header,\r\n.home-proof-row {\r\n  display: grid;\r\n  grid-template-columns: 2fr 2fr 2fr;\r\n  gap: 0;\r\n}\r\n\r\n.home-proof-header {\r\n  padding: 14px 24px;\r\n  background: rgba(0, 209, 255, 0.07);\r\n  border-bottom: 1px solid rgba(0, 209, 255, 0.16);\r\n}\r\n\r\n.home-proof-header span {\r\n  color: var(--accent-cyan);\r\n  font-size: 0.66rem;\r\n  font-weight: 800;\r\n  letter-spacing: 0.15em;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.home-proof-row {\r\n  padding: 16px 24px;\r\n  border-bottom: 1px solid rgba(255, 255, 255, 0.04);\r\n  align-items: center;\r\n  transition: background 160ms ease;\r\n  position: relative;\r\n}\r\n\r\n.home-proof-row:last-child { border-bottom: none; }\r\n\r\n.home-proof-row::before {\r\n  content: '';\r\n  position: absolute;\r\n  left: 0;\r\n  top: 50%;\r\n  transform: translateY(-50%);\r\n  width: 2px;\r\n  height: 60%;\r\n  background: transparent;\r\n  border-radius: 2px;\r\n  transition: background 200ms ease;\r\n}\r\n\r\n.home-proof-row:hover { background: rgba(0, 209, 255, 0.04); }\r\n.home-proof-row:hover::before { background: var(--accent-cyan); box-shadow: 0 0 8px var(--accent-cyan); }\r\n\r\n.home-proof-metric { color: #fff;                         font-size: 0.88rem; font-weight: 600; }\r\n.home-proof-before { color: rgba(255, 100, 100, 0.82);    font-size: 0.84rem; }\r\n.home-proof-after  { color: rgba(0, 255, 140, 0.88);       font-size: 0.84rem; font-weight: 600; }\r\n\r\n.home-proof-footnote {\r\n  margin-top: 18px;\r\n  color: var(--text-secondary);\r\n  font-size: 0.76rem;\r\n  line-height: 1.6;\r\n}\r\n.home-proof-footnote em { opacity: 0.7; }\r\n\r\n/* ══════════════════════════════════════════════════════════════════════════\r\n   ROLES GRID  —  numbered 3D tilt cards\r\n   ══════════════════════════════════════════════════════════════════════════ */\r\n.home-section--roles {\r\n  width: min(100% - 48px, 1320px);\r\n  max-width: none;\r\n  margin: 0 auto;\r\n  padding: 72px 48px;\r\n}\r\n\r\n.home-section--roles .home-section-heading { max-width: 100%; }\r\n\r\n.home-roles-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(3, minmax(0, 1fr));\r\n  gap: 16px;\r\n}\r\n\r\n@media (min-width: 1100px) {\r\n  .home-roles-grid {\r\n    grid-template-columns: repeat(3, minmax(0, 1fr));\r\n  }\r\n}\r\n\r\n.home-role-card {\r\n  position: relative;\r\n  padding: 22px 20px;\r\n  border: 1px solid rgba(0, 209, 255, 0.15);\r\n  border-radius: 10px;\r\n  background:\r\n    radial-gradient(circle at var(--gx, 50%) var(--gy, 0%), rgba(0, 209, 255, 0.07), transparent 58%),\r\n    linear-gradient(155deg, rgba(13, 21, 45, 0.97), rgba(6, 9, 24, 0.97) 60%, rgba(20, 15, 45, 0.97));\r\n  box-shadow: 0 14px 40px rgba(0, 0, 0, 0.44), inset 0 1px 0 rgba(255, 255, 255, 0.06);\r\n  backdrop-filter: blur(10px);\r\n  opacity: 0;\r\n  transform: translateY(40px);\r\n  transition:\r\n    opacity 0.5s ease calc(var(--role-delay, 0s)),\r\n    transform 0.5s ease calc(var(--role-delay, 0s)),\r\n    border-color 200ms ease,\r\n    box-shadow 200ms ease;\r\n  overflow: hidden;\r\n}\r\n\r\n.home-role-card.is-visible {\r\n  opacity: 1;\r\n  transform: translateY(0);\r\n}\r\n\r\n/* Number badge top-left */\r\n.home-role-num {\r\n  font-size: 0.6rem;\r\n  font-weight: 800;\r\n  letter-spacing: 0.16em;\r\n  color: var(--accent-cyan);\r\n  text-shadow: 0 0 10px rgba(0, 209, 255, 0.5);\r\n  margin-bottom: 10px;\r\n  font-family: var(--mono);\r\n  opacity: 0.72;\r\n}\r\n\r\n.home-role-card h3 {\r\n  margin: 0;\r\n  color: #fff;\r\n  font-size: 0.92rem;\r\n  font-weight: 700;\r\n  line-height: 1.45;\r\n}\r\n\r\n/* ══════════════════════════════════════════════════════════════════════════\r\n   FINAL CTA  —  portal ring effect\r\n   ══════════════════════════════════════════════════════════════════════════ */\r\n.home-final-cta {\r\n  position: relative;\r\n  text-align: center;\r\n  width: min(100% - 48px, 1320px);\r\n  max-width: none;\r\n  margin: 0 auto;\r\n}\r\n\r\n.home-final-cta > div {\r\n  position: relative;\r\n  z-index: 2;\r\n  max-width: 720px;\r\n  margin: 0 auto;\r\n}\r\n\r\n.home-final-cta p { margin: 0 0 36px; }\r\n\r\n/* Orbital rings behind the CTA text */\r\n.hp-cta-orbit {\r\n  position: absolute;\r\n  top: 50%;\r\n  left: -110px;\r\n  width: 340px;\r\n  height: 340px;\r\n  margin-top: -170px;\r\n  pointer-events: none;\r\n  z-index: 1;\r\n}\r\n\r\n.hp-cta-ring {\r\n  position: absolute;\r\n  border-radius: 50%;\r\n}\r\n\r\n.hp-cta-ring--1 {\r\n  inset: 0;\r\n  border: 1px solid rgba(0, 209, 255, 0.16);\r\n  box-shadow: 0 0 40px rgba(0, 209, 255, 0.05), inset 0 0 40px rgba(0, 209, 255, 0.03);\r\n  animation: hp-ring-spin 22s linear infinite;\r\n}\r\n\r\n.hp-cta-ring--2 {\r\n  inset: 30px;\r\n  border: 1px solid rgba(139, 92, 246, 0.12);\r\n  animation: hp-ring-spin 16s linear infinite reverse;\r\n}\r\n\r\n.hp-cta-ring--3 {\r\n  inset: 60px;\r\n  border: 1px dashed rgba(0, 209, 255, 0.08);\r\n  animation: hp-ring-spin 30s linear infinite;\r\n}\r\n\r\n/* Orbiting dot on ring 1 */\r\n.hp-cta-dot {\r\n  position: absolute;\r\n  top: 50%;\r\n  left: 0;\r\n  width: 8px;\r\n  height: 8px;\r\n  margin-top: -4px;\r\n  margin-left: -4px;\r\n  border-radius: 50%;\r\n  background: var(--accent-cyan);\r\n  box-shadow: 0 0 16px var(--accent-cyan), 0 0 32px rgba(0, 209, 255, 0.5);\r\n  animation: hp-ring-spin 22s linear infinite;\r\n  transform-origin: 170px center;\r\n}\r\n\r\n/* ══════════════════════════════════════════════════════════════════════════\r\n   RESPONSIVE\r\n   ══════════════════════════════════════════════════════════════════════════ */\r\n@media (max-width: 1200px) {\r\n  .hp-hud { display: none; }\r\n}\r\n\r\n@media (max-width: 1100px) {\r\n  .home-stat-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }\r\n\r\n  .home-hero-local {\r\n    padding-right: 26px;\r\n    padding-left: 26px;\r\n  }\r\n\r\n  .home-title--headline {\r\n    font-size: 3rem;\r\n  }\r\n\r\n  .home-lede {\r\n    font-size: 1.05rem;\r\n  }\r\n}\r\n\r\n@media (max-width: 900px) {\r\n  .home-stat-grid,\r\n  .home-roles-grid { grid-template-columns: 1fr; }\r\n\r\n  .hp-particles { display: none; }\r\n\r\n  .home-hero-section {\r\n    padding: 48px 24px 56px;\r\n    min-height: auto;\r\n  }\r\n\r\n  .home-hero-inner {\r\n    grid-template-columns: 1fr;\r\n    gap: 40px;\r\n  }\r\n\r\n  .home-hero-rack {\r\n    height: 400px;\r\n    min-height: 340px;\r\n  }\r\n\r\n  .home-hero-headline { font-size: 2.2rem; }\r\n\r\n  .home-section { padding-right: 0; padding-left: 0; }\r\n\r\n  .home-section--problem {\r\n    width: 100%;\r\n    max-width: none;\r\n    margin: 0 auto;\r\n    padding: 56px 0;\r\n    border: 0;\r\n    background: transparent;\r\n    box-shadow: none;\r\n    backdrop-filter: none;\r\n  }\r\n\r\n  .home-section--problem .home-stat-grid { grid-template-columns: 1fr; }\r\n\r\n  .home-section--what {\r\n    width: 100%;\r\n    max-width: none;\r\n    margin: 0 auto;\r\n  }\r\n\r\n  .hp-what-badge { display: none; }\r\n\r\n  .home-final-cta {\r\n    width: 100%;\r\n    max-width: none;\r\n    margin: 0 auto;\r\n    text-align: center;\r\n  }\r\n\r\n  .home-final-cta > div { margin: 0 auto; }\r\n  .home-final-cta p     { margin: 0 auto 36px; }\r\n\r\n  .home-section-heading h2,\r\n  .home-final-cta h2 { font-size: 2.1rem; }\r\n\r\n  .cap-grid-stack { grid-template-columns: repeat(2, minmax(0, 1fr)); }\r\n  .cap-card:nth-child(n) { grid-column: auto; }\r\n\r\n  .cap-sticky-wrap {\r\n    height: auto;\r\n    position: relative;\r\n    padding: 48px 0;\r\n  }\r\n\r\n  .cap-section {\r\n    min-height: auto;\r\n  }\r\n\r\n  .cap-card {\r\n    padding: 16px 14px;\r\n    opacity: 1;\r\n  }\r\n\r\n  .home-section--roles {\r\n    width: 100%;\r\n    max-width: none;\r\n    margin: 0 auto;\r\n  }\r\n\r\n  .home-section--proof {\r\n    width: 100%;\r\n    max-width: none;\r\n    margin: 0 auto;\r\n  }\r\n\r\n  .home-proof-header,\r\n  .home-proof-row { grid-template-columns: 1fr; gap: 4px; }\r\n  .home-proof-header span:not(:first-child) { display: none; }\r\n\r\n  .hp-cta-orbit { display: none; }\r\n}\r\n"
